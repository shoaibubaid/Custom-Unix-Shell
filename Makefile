CC        = gcc
CFLAGS    = -Wall -Wextra -Wpedantic -std=gnu11 -g -MMD -MP
TARGET    = shell
BUILD_DIR = build

# Picks up every .c file in this directory, so later parts just add files.
SRCS      = $(wildcard *.c)
OBJS      = $(SRCS:%.c=$(BUILD_DIR)/%.o)
DEPS      = $(OBJS:.o=.d)

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(CFLAGS) -o $@ $^

# .o and .d files (written by -MMD next to the .o) all land in $(BUILD_DIR)
$(BUILD_DIR)/%.o: %.c
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -c -o $@ $<

run: $(TARGET)
	./$(TARGET)

test: $(TARGET)
	./test.sh

clean:
	rm -rf $(BUILD_DIR) $(TARGET)

# Rebuild automatically when a header changes (generated by -MMD)
-include $(DEPS)

.PHONY: all run test clean
